# Netlify Environment Variables Configuration
# Copy this file to .env for local testing, or set these in the Netlify Dashboard:
# Netlify UI > Site Configuration > Environment variables

# Recruiter Passcode (case-insensitive)
RECRUITER_PASSCODE=BPW2026

# Sensitive Contact Information (Delivered securely upon passcode verification)
CONTACT_EMAIL=your-email@example.com
CONTACT_PHONE=+63 900 000 0000
CONTACT_LOCATION=City, Country (Remote Ready)
